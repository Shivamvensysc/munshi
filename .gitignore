# ============================================================
# DEPENDENCIES
# ============================================================

node_modules/
.pnp/
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions


# ============================================================
# BUILD / DISTRIBUTION
# ============================================================

dist/
build/
out/
.next/
.nuxt/
.output/
.vite/
.cache/
.parcel-cache/
.turbo/


# ============================================================
# ENVIRONMENT VARIABLES / SECRETS
# ============================================================

# Ignore all local environment files
.env
.env.*
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local

# Keep example environment files committed
!.env.example
!.env.sample
!.env.template


